# Copia este archivo como .env.local y ajusta los valores.

# MongoDB (local o Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=anzuelo
# Opcional, solo si en Windows aparece "querySrv ECONNREFUSED" con mongodb+srv://
# (Node consulta el DNS en 127.0.0.1). No hace falta en Vercel.
# DNS_SERVERS=192.168.1.1,8.8.8.8

# URL pública del sitio (Wompi la usa para el redirect y el webhook)
APP_URL=http://localhost:3000

# Pagos: "mock" = pago simulado (solo fuera de producción) | "wompi" = Wompi El Salvador
PAYMENTS_MODE=mock

# Credenciales de Wompi (panel.wompi.sv > tu aplicativo)
WOMPI_APP_ID=
WOMPI_API_SECRET=
# En producción los pagos de prueba se ignoran salvo que esto sea "true"
WOMPI_ALLOW_TEST=false

# Correos (recuperar contraseña) con Resend: resend.com > API Keys.
# Vacío = no se envían; en desarrollo el enlace aparece en pantalla y en la consola.
RESEND_API_KEY=
# Remitente de un dominio verificado en Resend
EMAIL_FROM="Ciberlearn <no-responder@tudominio.com>"
