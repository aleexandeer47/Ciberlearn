# Copia este archivo como .env.local y ajusta los valores.

# MongoDB (local o Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=anzuelo
# Opcional, solo si en Windows aparece "querySrv ECONNREFUSED" con mongodb+srv://
# (Node consulta el DNS en 127.0.0.1). No hace falta en Vercel.
# DNS_SERVERS=192.168.1.1,8.8.8.8

# URL pública del sitio (Wompi la usa para el redirect y el webhook)
APP_URL=http://localhost:3000

# Pagos: "mock" = pago simulado (solo fuera de producción) | "wompi" = Wompi El Salvador
PAYMENTS_MODE=mock

# Credenciales de Wompi (panel.wompi.sv > tu aplicativo)
WOMPI_APP_ID=
WOMPI_API_SECRET=
# En producción los pagos de prueba se ignoran salvo que esto sea "true"
WOMPI_ALLOW_TEST=false

# Chats con IA (exclusivos de Pro). Solo se activan con AI_CHAT_ENABLED=true Y la clave;
# si no, los botones aparecen pero muestran "Aún no está listo".
AI_CHAT_ENABLED=false
ANTHROPIC_API_KEY=
# Modelo de Claude. Por defecto el más capaz; puedes poner uno más económico.
# AI_MODEL=claude-opus-5-5

# Correos (recuperar contraseña). Usa Mailjet o Resend; si hay claves de los dos, se usa Mailjet.
# Vacío = no se envían; en desarrollo el enlace aparece en pantalla y en la consola.
# Mailjet: app.mailjet.com > Account settings > API Key Management (API Key y Secret Key)
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
# Resend: resend.com > API Keys
RESEND_API_KEY=
# Remitente: debe estar verificado en el servicio (Mailjet: Senders & Domains)
EMAIL_FROM="Unhooked <no-responder@tudominio.com>"

# Notificaciones (recordatorio diario de la estafa del día). Genera las claves con:
#   npx web-push generate-vapid-keys
# Sin estas variables el botón del recordatorio no aparece.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:tu-correo@ejemplo.com"
# Lo envía Vercel Cron a /api/cron/daily-push (ver vercel.json). Cualquier texto largo y secreto.
CRON_SECRET=""

# Datos del proveedor (Ley de Protección al Consumidor). Se muestran en /terminos. No los pongas en el código: el repositorio es público.
PROVIDER_LEGAL_NAME=
PROVIDER_NIT=
PROVIDER_ADDRESS=
PROVIDER_PHONE=

